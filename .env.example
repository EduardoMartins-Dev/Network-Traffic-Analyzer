# Copie para .env (lido pelo docker compose e pelo scripts/up.sh).
# Sem .env a stack sobe com os defaults de desenvolvimento do docker-compose.yml.
# RabbitMQ/InfluxDB só aplicam usuário/senha/token na PRIMEIRA subida (volume vazio).

# RabbitMQ — usado pelo nta-server e pelos agentes locais (AGENT_ID/AGENT_TOKEN)
RABBITMQ_USER=nta
RABBITMQ_PASS=troque-esta-senha

# InfluxDB — token compartilhado por nta-server, Grafana e scripts/influx_retention.sh
INFLUX_PASSWORD=troque-esta-senha
INFLUX_TOKEN=troque-por-um-token-longo-e-aleatorio

# Grafana (usuário admin)
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# Alertas Grafana → Telegram (bot via @BotFather, chat_id via @userinfobot).
# Vazio = alertas desligados.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alertas Grafana → canais extras (opcionais). Cada canal só recebe alertas se
# NTA_ALERT_CANAIS listar o nome dele: slack, discord, ntfy (ex.: slack,ntfy).
# Vazio = só Telegram. Política completa em grafana/provisioning/alerting/notification-policies.yaml.
NTA_ALERT_CANAIS=
# Slack: URL de Incoming Webhook (api.slack.com/apps → Incoming Webhooks).
SLACK_WEBHOOK_URL=
# Discord: URL de webhook do canal (Configurações do canal → Integrações → Webhooks).
DISCORD_WEBHOOK_URL=
# ntfy: URL completa do tópico (ex.: https://ntfy.sh/nta-alertas) e token (só para tópico protegido).
# Entrega via webhook: a mensagem chega como JSON do Grafana (o Grafana 13 não tem tipo ntfy nativo).
NTFY_URL=
NTFY_ACCESS_TOKEN=

# Token compartilhado Grafana ↔ grafana-image-renderer
GF_RENDERER_TOKEN=nta-render-token-change-me

# Exportação de alertas para SIEM (CEF/ECS via syslog). Desligada por padrão.
# Variáveis NTA_EXPORT_* e exemplo completo em deploy/nta-export.env.example.
# NTA_EXPORT_FORMAT=cef
