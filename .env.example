# Copie para .env (lido pelo docker compose e pelo scripts/up.sh).
# Sem .env a stack sobe com os defaults de desenvolvimento do docker-compose.yml.
# RabbitMQ/InfluxDB só aplicam usuário/senha/token na PRIMEIRA subida (volume vazio).

# RabbitMQ — usado pelo nta-server e pelos agentes locais (AGENT_ID/AGENT_TOKEN)
RABBITMQ_USER=nta
RABBITMQ_PASS=troque-esta-senha

# InfluxDB — token compartilhado por nta-server, Grafana e scripts/influx_retention.sh
INFLUX_PASSWORD=troque-esta-senha
INFLUX_TOKEN=troque-por-um-token-longo-e-aleatorio

# Grafana (usuário admin)
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# Alertas Grafana → Telegram (bot via @BotFather, chat_id via @userinfobot).
# Vazio = alertas desligados.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token compartilhado Grafana ↔ grafana-image-renderer
GF_RENDERER_TOKEN=nta-render-token-change-me
