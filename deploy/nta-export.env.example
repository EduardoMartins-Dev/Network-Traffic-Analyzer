# Exportação de alertas para SIEM (nta-server, B11). Opcional e DESLIGADA por padrão.
#
# Para ligar: copie as linhas desejadas para o `.env` na raiz do projeto (o docker
# compose lê o `.env` e repassa estas variáveis ao container nta-server) e suba de
# novo com `docker compose up -d`. Este arquivo não é lido pelo compose; é só modelo.
#
# Só alertas são exportados (attack_type diferente de "NONE"); pacotes benignos não saem.
# Destino: linha syslog RFC 5424 por UDP (RFC 5426) ou TCP (octet-counting, RFC 6587).
#
# Vazio ou ausente = desligado, e o container se comporta como antes.

# Formato do payload: cef (ArcSight CEF v0) ou ecs (JSON Elastic Common Schema 8.11.0).
# Valor diferente de cef/ecs é ignorado com aviso no log e a exportação fica desligada.
NTA_EXPORT_FORMAT=

# Destino syslog. Obrigatório quando NTA_EXPORT_FORMAT estiver ligado; sem ele a exportação
# é desligada com aviso. Use o IP ou nome do coletor (exemplo: siem.example.invalid).
NTA_EXPORT_SYSLOG_HOST=

# Porta do coletor. Padrão 514. Valor fora de 1..65535 ou não numérico cai no padrão.
NTA_EXPORT_SYSLOG_PORT=514

# Transporte: udp (padrão) ou tcp. Qualquer outro valor usa udp.
NTA_EXPORT_SYSLOG_PROTO=udp

# Campo HOSTNAME da mensagem RFC 5424. Padrão nta-server. Caracteres fora de ASCII imprimível viram "_".
NTA_EXPORT_HOSTNAME=nta-server

# Tamanho da fila entre o consumer e a thread de envio, em eventos. Padrão 1024, faixa 16..65536.
# Fora da faixa ou não numérico cai no padrão. Fila cheia descarta o alerta e conta em log.
NTA_EXPORT_QUEUE=1024

# Prazo de conexão e de envio ao coletor, em ms. Padrão 500, faixa 50..10000.
# Fora da faixa ou não numérico cai no padrão.
NTA_EXPORT_TIMEOUT_MS=500
