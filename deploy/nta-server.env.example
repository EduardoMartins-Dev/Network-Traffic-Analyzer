# /etc/default/nta-server — env vars carregadas pelo systemd
# Copiar p/ /etc/default/nta-server (root:root 600) e ajustar.

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=CHANGE-ME-LONG-RANDOM-TOKEN
INFLUX_ORG=cybersecurity
INFLUX_BUCKET=network_traffic

# --- RabbitMQ ---
RABBIT_HOST=localhost
RABBIT_PORT=5674
RABBIT_USER=guest
RABBIT_PASS=guest

# --- GeoIP (paths absolutos em prod) ---
GEOIP_DB_PATH=/opt/nta/data/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=/opt/nta/data/GeoLite2-ASN.mmdb

# --- IoC blocklist ---
IOC_PATH=/opt/nta/deploy/ioc/blocklist.json

# --- AbuseIPDB (opcional) ---
ABUSEIPDB_API_KEY=
ABUSEIPDB_MIN_REPUBLISH_SCORE=75

# --- Narrator (Groq, opcional) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NARRATOR_MIN_SCORE=80

# --- WHOIS ---
WHOIS_ENABLED=1
WHOIS_TIMEOUT=5

# --- Health endpoint ---
# Localhost default. Pra Prometheus externo, bind 0.0.0.0 + colocar reverse
# proxy TLS na frente (nginx/caddy).
NTA_HEALTH_PORT=9091
NTA_HEALTH_BIND=127.0.0.1

# --- Pool workers ---
NTA_WORKERS=4
NTA_SCALER_ENABLED=1
NTA_SCALER_MAX=16
