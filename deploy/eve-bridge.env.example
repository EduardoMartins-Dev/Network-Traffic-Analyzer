# Modelo do nta-eve-bridge (B17). Copie para deploy/eve-bridge.env (não versionado)
# e ajuste. Formato igual ao do agente: --config <arquivo>. Variável já definida
# no ambiente tem precedência sobre o arquivo. Valor vazio conta como ausente.
#
# Sem segredos aqui. O token e os certificados AMQP ficam no arquivo do agente
# (AGENT_TOKEN, AGENT_CLIENT_CERT, AGENT_CLIENT_KEY); a ponte roda com o mesmo AGENT_ID.

# eve.json do Suricata (seguido; rotação e truncamento tratados)
BRIDGE_EVE_PATH=/var/log/suricata/eve.json
# Tabela de mapeamento (categoria -> estágio, severidade -> score)
BRIDGE_MAPPING_FILE=/opt/nta/deploy/eve-bridge.mapping.json
# Janela de agregação por (signature_id, src_ip), em ms. 0 desliga
BRIDGE_AGG_WINDOW_MS=10000
# Registros publicados por segundo. 0 desliga o limite
BRIDGE_RATE_PER_SEC=100
# Lado do atacante: src (padrão) ou response (dest_ip quando direction = to_client)
BRIDGE_ATTACKER_SIDE=src
# Intervalo dos contadores no log, em segundos
BRIDGE_STATS_INTERVAL_SEC=10

# AMQP (mesmas chaves do agente)
AGENT_SERVER_HOST=
AGENT_SERVER_PORT=5674
AGENT_VHOST=/
AGENT_ID=
AGENT_TOKEN=
AGENT_USE_TLS=0
AGENT_CA_CERT=
AGENT_CLIENT_CERT=
AGENT_CLIENT_KEY=
