# abuseipdb.env — credencial AbuseIPDB API (v8.0 M4).
# Copie para `abuseipdb.env` (mesmo diretório) e preencha os valores reais.
# `abuseipdb.env` está no .gitignore (regra /deploy/secrets/*).
#
# Conta grátis em https://www.abuseipdb.com/account (1000 checks/dia).
# Sem key: nta-server roda normal — só não emite a tag abuse_score.

ABUSEIPDB_API_KEY=

# Opcional — defaults razoáveis:
# ABUSEIPDB_URL=https://api.abuseipdb.com/api/v2/check
# ABUSEIPDB_TIMEOUT=5
# ABUSEIPDB_MAX_AGE_DAYS=90
# ABUSEIPDB_TTL=86400            # cache positivo (24h)
# ABUSEIPDB_NEG_TTL=300          # cache negativo (5min) — evita martelar API em fail
# ABUSEIPDB_MIN_REPUBLISH_SCORE=75   # republica narrator se score >= N (0=off)
