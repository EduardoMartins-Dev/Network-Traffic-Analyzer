# ============================================================================
# Network Traffic Analyzer — configuração do agente sensor
#
# Copie para /etc/default/nta-agent (ou onde preferir), ajuste host e token
# e faça `set -a; source <arquivo>; set +a` antes de rodar o binário.
#
# O systemd unit em deploy/agent.service já lê /etc/default/nta-agent
# automaticamente via EnvironmentFile.
# ============================================================================

# ---- Conexão com o servidor central (obrigatórios em deploy remoto) --------
AGENT_SERVER_HOST=servidor.empresa.com
AGENT_SERVER_PORT=5674
AGENT_VHOST=/

# ATENÇÃO: o user `guest` do RabbitMQ só aceita login de 127.0.0.1.
# Em deploy remoto, crie um user dedicado no servidor:
#   docker exec rabbitmq rabbitmqctl add_user agente-01 <senha-forte>
#   docker exec rabbitmq rabbitmqctl set_permissions -p / agente-01 ".*" ".*" ".*"
AGENT_ID=agente-01
AGENT_TOKEN=TROQUE_ISTO

# ---- TLS (opcional, recomendado fora de rede confiável) --------------------
AGENT_USE_TLS=0
# AGENT_SERVER_PORT=5671          # porta AMQPS ao ativar TLS
# AGENT_CA_CERT=/etc/nta-agent/ca.crt

# ---- mTLS (v7.0): cert do cliente substitui AGENT_TOKEN -------------------
# Quando AGENT_CLIENT_CERT/KEY existem, o agente faz SASL EXTERNAL — o CN do
# cert vira o user no broker (precisa bater com agent-<nome> provisionado).
# AGENT_CLIENT_CERT=/etc/nta-agent/agent-01.crt
# AGENT_CLIENT_KEY=/etc/nta-agent/agent-01.key

# ---- Filas (ajuste só se o servidor usa nomes customizados) ----------------
AGENT_QUEUE=traffic_queue
AGENT_METRICS_QUEUE=traffic_metrics

# ---- Pipeline / tuning (v5.0) ----------------------------------------------
# Aumente BUFFER_SIZE se rb_pkt_overflow > 0 nas métricas.
AGENT_BUFFER_SIZE=4096
AGENT_BATCH_SIZE=50
AGENT_BATCH_TIMEOUT_MS=100
AGENT_METRICS_INTERVAL_SEC=10

# ---- Interface capturada ---------------------------------------------------
# Lida diretamente pelo systemd unit; não é variável do binário.
AGENT_IFACE=eth0
