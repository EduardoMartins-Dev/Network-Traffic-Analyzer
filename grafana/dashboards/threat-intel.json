    {
      "type": "geomap",
      "id": 8,
      "title": "Mapa de ameaças",
      "description": "Densidade e origem dos ataques (GeoIP).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-nta"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nta"
          },
          "query": "from(bucket: \"network_traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"traffic\")\n  |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\" or r._field == \"is_scan\")\n  |> pivot(rowKey: [\"_time\", \"src_ip\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.lat and exists r.lon and r.is_scan == 1.0)\n  |> group(columns: [\"src_ip\"])\n  |> reduce(identity: {lat: 0.0, lon: 0.0, eventos: 0, ataque: \"\"},\n            fn: (r, accumulator) => ({lat: r.lat, lon: r.lon, eventos: accumulator.eventos + 1, ataque: r.attack_type}))\n  |> group()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#FF9830",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "basemap": {
          "type": "xyz",
          "name": "Base escura",
          "config": {
            "url": "https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}",
            "attribution": "Tiles © Esri"
          }
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showZoom": true,
          "showScale": false,
          "showDebug": false
        },
        "layers": [
          {
