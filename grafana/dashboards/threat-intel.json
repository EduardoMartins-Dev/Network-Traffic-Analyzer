    {
      "type": "table",
      "id": 13,
      "title": "Kill chain por ASN",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-nta"
      },
      "description": "Maior kc_score por ASN e estágio da kill chain.",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nta"
          },
          "query": "from(bucket: \"network_traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"traffic\" and r._field == \"kc_score\")\n  |> filter(fn: (r) => exists r.asn_org and r.asn_org != \"\" and exists r.kill_chain_stage and r.kill_chain_stage != \"IDLE\")\n  |> group(columns: [\"asn_org\", \"kill_chain_stage\"])\n  |> max()\n  |> group()\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 15)\n  |> map(fn: (r) => ({asn: r.asn_org, estagio: r.kill_chain_stage, score: r._value}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "sem dados"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "asn"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ASN"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "estagio"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Estágio"
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "mappings",
                "value": [
